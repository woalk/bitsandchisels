{
  "schemaVersion": 1,
  "id": "bitsandchisels",
  "version": "${version}",
  "name": "Woalk's BitsAndChisels",
  "description": "Turn Blocks Into Small Bits With Chisels; Build All The Things",
  "authors": [
    "cool_mineman",
    "woalk"
  ],
  "contact": {
    "homepage": "https://mods.iramesia.com/docs/bitsandchisels/",
    "sources": "https://git.woalk.com/mc-mods/bitsandchisels"
  },
  "license": "GPL-3.0-or-later",
  "icon": "assets/bitsandchisels/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.woalk.mods.bitsandchisels.BitsAndChisels",
      {
        "adapter": "kotlin",
        "value": "com.woalk.mods.bitsandchisels.BitsAndChiselsMod"
      }
    ],
    "client": [
      "com.woalk.mods.bitsandchisels.BitsBlockClient",
      {
        "adapter": "kotlin",
        "value": "com.woalk.mods.bitsandchisels.BitsAndChiselsClientMod"
      }
    ]
  },
  "accessWidener": "bitsandchisels.accesswidener",
  "mixins": [
    "bitsandchisels.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "26.2",
    "fabric-api": "*"
  },
  "recommends": {
    "worldedit": "*",
    "wdf": ">=1.1.0"
  }
}
